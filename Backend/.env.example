# --- Server ---
PORT=
NODE_ENV=
CORS_ORIGIN=

# --- Database (MySQL) ---
# Pointed at your standalone MySQL84 server (the one MySQL Workbench's
# "Local instance MySQL84" connects to) â€” NOT XAMPP's bundled MySQL.
# That's where your actual `bongalink` schema and admin row live.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=
