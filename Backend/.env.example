# =====================================================================
# Bongalink backend — .env
# Place at the ROOT of your backend/ folder (same level as server.js).
# Never commit .env — it's git-ignored. Only this template is committed.
# REQUIRED to start: DB_*, DATA_ENCRYPTION_KEY, DATA_INDEX_KEY, JWT_SECRET.
# Everything else turns a feature on (the startup log lists which are on).
# With Docker, use the .env.example next to docker-compose.yml instead.
# =====================================================================

# --- Server ---
# Port the API listens on (default 4000).
PORT=4000
# "production" on the live server, "development" locally.
NODE_ENV=development
# Browser origins allowed to call the API, comma-separated, e.g.
#   http://localhost:5500,http://127.0.0.1:5500     (local)    https://shop.example.com     (live)
CORS_ORIGIN=
# Proxies in front of the API (nginx, a hosting load balancer, an HTTPS terminator):
# their number (usually 1) or their addresses, e.g. loopback or 10.0.0.0/8. Blank when
# browsers reach the API directly. Needed so the per-IP rate limits see each visitor's
# own address instead of the proxy's. Never "true" (visitors could fake their IP).
TRUST_PROXY=
# Where uploaded product photos are stored (default Backend/uploads/). Served at /uploads/<file>.
UPLOAD_DIR=
# Full URL of the Frontend/ folder as the browser sees it — NOT just the host.
# PayMongo sends the customer back to APP_URL/Pages/COpage/checkout.html, so
# that page must open at this address. Check it in the browser first.
#   VS Code Live Server opened on the repo folder:  http://localhost:5500/Frontend
#   Docker (nginx serves Frontend/ at the root):     http://localhost:5500
APP_URL=

# --- Database (MySQL) ---
# Pointed at your standalone MySQL84 server (the one MySQL Workbench's
# "Local instance MySQL84" connects to) — NOT XAMPP's bundled MySQL.
# The real data lives in `bongalink_real`; ml/worker/.env must use the same DB_NAME.
# REQUIRED.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Encryption of personal information (REQ027, REQ030; RA 10173) ---
# REQUIRED: the server won't start without them. Each is 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK THESE UP somewhere safe and separate from the database backups. If they are
# lost, every encrypted email, name, phone, address and chat message is lost for good.
DATA_ENCRYPTION_KEY=
DATA_INDEX_KEY=
# Key rotation: give the new key a higher version and keep the old one as
# DATA_ENCRYPTION_KEY_V<old version> so existing values still decrypt.
DATA_ENCRYPTION_KEY_VERSION=1
# DATA_ENCRYPTION_KEY_V1=

# --- Auth ---
# REQUIRED. Signs login tokens: a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it logs everyone out.
JWT_SECRET=
# Failed logins allowed per IP in 15 minutes, across all usernames (default 50). Raise it
# for a test session where many people share one public IP; set it back afterwards.
# (10 failures per username from one IP is fixed and can't be raised.)
RATE_LIMIT_LOGIN_PER_IP=
# Other per-IP limits (blank = the default shown). Raise them together for a shared-IP test session.
#   new accounts per hour / per day (each sends an email): 5 / 20
RATE_LIMIT_REGISTER_PER_IP_HOUR=
RATE_LIMIT_REGISTER_PER_IP_DAY=
#   email-code requests and guesses per 15 minutes: 20
RATE_LIMIT_VERIFY_EMAIL_PER_IP=
#   forgot-password requests per 15 minutes: 10 (3 per email per hour is fixed)
RATE_LIMIT_FORGOT_PASSWORD_PER_IP=
#   chat messages per minute / per day: 20 / 300 (8 per chat per minute is fixed)
RATE_LIMIT_CHAT_PER_IP_MINUTE=
RATE_LIMIT_CHAT_PER_IP_DAY=
# How long a normal login lasts (default 7d). "Remember me" lasts 30 days.
JWT_EXPIRES_IN=7d

# --- Email verification (Gmail: turn on 2-Step Verification, then create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bongalink <your-shop@gmail.com>"
# Shop inbox that gets an email for every paid order (products, courier, address)
ADMIN_ALERT_EMAIL=
# Long random string used to hash verification codes, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERIFICATION_SECRET=

# --- PayMongo (Dashboard > Developers): sk_test_... and whsk_...
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_METHODS=gcash,qrph,dob,dob_ubp

# --- Lalamove (Partner Portal > Developers, Sandbox keys). Leave blank to offer J&T/LBC only.
LALAMOVE_ENV=sandbox
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_SERVICE_TYPE=MOTORCYCLE
# Where Lalamove can deliver from the shop: PSGC region codes and/or province names.
LALAMOVE_SERVICE_AREAS=NCR,Bulacan,Cavite,Laguna,Rizal

# --- Map pins (reverse geocoding with OpenStreetMap Nominatim, called from the backend only)
# Nominatim's usage policy asks for a contact in the User-Agent. Defaults to ADMIN_ALERT_EMAIL.
GEOCODER_CONTACT=
# Leave blank for the public server (max 1 request/second, results are cached).
NOMINATIM_URL=

# --- Shop pickup point (Lalamove pickup + sender details)
STORE_LAT=
STORE_LNG=
STORE_ADDRESS=
STORE_CONTACT_NAME=Bongalink
STORE_PHONE=

# --- AI chat support (Google Gemini, called from the backend only)
# API key from Google AI Studio (https://aistudio.google.com/apikey). Leave blank to turn the
# chat assistant off: customers then get the shop's contact details instead.
GEMINI_API_KEY=
# Leave blank for the default (gemini-3.8-flash).
GEMINI_MODEL=
# Used once when the main model is busy or times out. Default gemini-3.5-flash-lite;
# set it to the same name as GEMINI_MODEL to turn the retry off.
GEMINI_FALLBACK_MODEL=
# Shown by the chat when it can't help (with STORE_PHONE and STORE_ADDRESS above).
STORE_EMAIL=

# --- Courier tracking page templates ({tn} = tracking number). Leave blank to show the number only.
TRACKING_URL_JNT=
TRACKING_URL_LBC=
