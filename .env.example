# =====================================================================
# Bongalink — .env for docker compose (copy to .env next to docker-compose.yml)
# Never commit .env — it's git-ignored. Only this template is committed.
# docker-compose.yml passes these to the containers; running without Docker,
# use Backend/.env and ml/worker/.env instead (same names, see their .env.example).
# =====================================================================

# --- REQUIRED -----------------------------------------------------------

# MySQL root password (the containers connect as root; see DEPLOYMENT.md for a
# least-privilege user in production).
DB_PASSWORD=
# Signs login tokens. A long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Encryption of personal information: 32 random bytes each, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# For an existing database these MUST be the keys it was encrypted with, or every
# encrypted email, name, phone, address and chat message becomes unreadable.
# Store them in a password manager, separately from the database backups.
DATA_ENCRYPTION_KEY=
DATA_INDEX_KEY=

# --- OPTIONAL (blank = the default in docker-compose.yml) ---------------

# Database the API and the worker use (default bongalink). The real shop data is bongalink_real.
DB_NAME=
# Browser origins allowed to call the API, comma-separated (default the local frontend on :5500).
CORS_ORIGIN=
# Full URL of the frontend as the browser sees it; PayMongo returns customers here.
APP_URL=
# Proxies in front of the API (usually 1 behind nginx / an HTTPS terminator; blank = none).
# See Backend/.env.example.
TRUST_PROXY=
# How long a normal login lasts (default 7d). "Remember me" lasts 30 days.
JWT_EXPIRES_IN=
# Key rotation only: the version of DATA_ENCRYPTION_KEY, and the previous key.
DATA_ENCRYPTION_KEY_VERSION=
DATA_ENCRYPTION_KEY_V1=

# Email (Gmail App Password): verification codes, password resets, order alerts.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_ALERT_EMAIL=
# Long random string used to hash verification codes.
VERIFICATION_SECRET=

# PayMongo (sk_test_... while testing; sk_live_... only at go-live) and its webhook secret.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_METHODS=

# Lalamove (blank = J&T/LBC only).
LALAMOVE_ENV=
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_SERVICE_TYPE=
LALAMOVE_SERVICE_AREAS=

# Map pin lookups (OpenStreetMap Nominatim): a contact for its usage policy; blank URL = public server.
GEOCODER_CONTACT=
NOMINATIM_URL=

# Shop pickup point and contact details (Lalamove pickup, chat fallback reply).
STORE_LAT=
STORE_LNG=
STORE_ADDRESS=
STORE_CONTACT_NAME=
STORE_PHONE=
STORE_EMAIL=

# AI chat support (Google Gemini). Blank key = the chat gives the shop's contact details instead.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Courier tracking page templates ({tn} = tracking number).
TRACKING_URL_JNT=
TRACKING_URL_LBC=

# ML worker tuning (see ml/worker/.env.example for what each does).
ML_TRAINER=
ML_POLL_SECONDS=
ML_QUIET_SECONDS=
ML_MAX_WAIT_SECONDS=
ML_FULL_REFRESH_MINUTES=
ML_RETRY_SECONDS=
ML_COLD_START_DAYS=
ML_TREND_MIN_SALE_DAYS=
ML_RETRAIN_HOUR=
ML_RETRAIN_NEW_ORDERS=
ML_RETRAIN_STOCK_CHANGES=
ML_LOG_LEVEL=
