# nginx for the live shop: ONE HTTPS address serves the pages (Frontend/) and passes /api and
# /uploads to the Node API on this machine. DEPLOYMENT.md, "One HTTPS address".
#   1. Copy to /etc/nginx/sites-available/bongalink, replace shop.example.com (4 places) and the
#      paths, then: ln -s ../sites-available/bongalink /etc/nginx/sites-enabled/ && nginx -t && systemctl reload nginx
#   2. Certificates: certbot --nginx -d shop.example.com (Let's Encrypt), or your host's own.
#   3. Backend/.env: TRUST_PROXY=1, APP_URL=https://shop.example.com, CORS_ORIGIN=https://shop.example.com
#      Frontend/JS/config.js stays blank: the pages then use https://shop.example.com/api.
# The security headers are the same as deploy/nginx/frontend.conf.template (Docker), with the API on
# the same address, plus HSTS. Backend/tests/securityHeaders.test.js checks both files.

server {
    listen 80;
    server_name shop.example.com;
    return 301 https://$host$request_uri;      # never serve the shop over plain http
}

server {
    listen 443 ssl;
    http2 on;
    server_name shop.example.com;

    ssl_certificate     /etc/letsencrypt/live/shop.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shop.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /opt/bongalink/Frontend;
    server_tokens off;
    # Product photos are uploaded through /api (5 MB each, the API's own limit).
    client_max_body_size 6m;

    location = / { return 302 /Pages/Homepage/homepage.html; }
    # The pages and their files. (Headers are set here, not for the whole server: nginx would add them
    # to the API's answers too, which carry their own from helmet, HSTS included in production.)
    location / {
        try_files $uri $uri/ =404;
        add_header Strict-Transport-Security "max-age=15552000" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # Page assets only: never dotfiles (.env, .git) or notes/backups that end up in this folder.
        location ~ /\.(?!well-known/) { return 404; }
        location ~* \.(md|map|bak|orig|old|sql|log|zip|tgz)$ { return 404; }
    }

    # The Node API (and the PayMongo / Lalamove webhooks under /api/v1/webhooks/).
    # Its own security headers come with its answers.
    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;        # the chat waits up to 45 s for Gemini, checkout up to 15 s per PayMongo call
    }
    # The admin bell's live updates (Server-Sent Events): no buffering, kept open.
    location /api/v1/admin/notifications/stream {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;         # the API sends a heartbeat every 25 s
    }
    location /uploads/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
    }
}
