# =====================================================================
# Bongalink — production .env for docker compose (DigitalOcean server, domain on Cloudflare)
#
# TEMPLATE ONLY: no real values. The server's file is /opt/bongalink/.env (next to
# docker-compose.yml), git-ignored, chmod 600. Make it ON THE SERVER with:
#     bash deploy/make-production-env.sh /root/local.env
# where /root/local.env is a copy of your local Backend/.env (scp it over, delete it afterwards).
#
# The placeholders tell the script what to do with each line:
#   <COPY>         copied from your local Backend/.env (same name)
#   <GENERATE ...> a new random value made on the server (the command is in the comment above it)
#   <DOMAIN>       replaced with the domain you type, e.g. shop.example.com
#   <NEW_WEBHOOK>  left blank: filled in by you after the domain is live (see PayMongo below)
#   anything else  written as it is (fixed production values; blank = the default)
# Re-running the script keeps the GENERATED values and the webhook secret already in
# /opt/bongalink/.env (the MySQL volume keeps the first root password for good).
# Every variable is described in .env.example (next to docker-compose.yml) and DEPLOYMENT.md, section 3.
# =====================================================================

# --- Fixed production values ------------------------------------------
# docker-compose.yml already runs the API with NODE_ENV=production; kept here so the file says so.
NODE_ENV=production
DB_NAME=bongalink_real
# One proxy (nginx on the server) in front of the API. If Cloudflare's proxy is ON (orange cloud),
# nginx must also restore the visitor's address from Cloudflare (real_ip, see the API check report);
# otherwise the per-IP rate limits see Cloudflare's addresses. With DNS only (grey cloud), 1 is right.
TRUST_PROXY=1
# Where customers open the shop; PayMongo sends them back here. Cloudflare SSL mode: Full (strict).
APP_URL=https://<DOMAIN>
CORS_ORIGIN=https://<DOMAIN>
# Only used by the optional frontend container; the pages and /api share one address (DEPLOYMENT.md, section 8).
API_ORIGIN=https://<DOMAIN>
# Least-privilege database accounts (deploy/mysql/create_app_users.sql with @app_host = '%').
API_DB_USER=bongalink_app
ML_DB_USER=bongalink_ml
# Rate limits: blank = the safe defaults. Raise them only for a test session, then blank them again.
RATE_LIMIT_LOGIN_PER_IP=
RATE_LIMIT_REGISTER_PER_IP_HOUR=
RATE_LIMIT_REGISTER_PER_IP_DAY=
RATE_LIMIT_VERIFY_EMAIL_PER_IP=
RATE_LIMIT_FORGOT_PASSWORD_PER_IP=
RATE_LIMIT_CHAT_PER_IP_MINUTE=
RATE_LIMIT_CHAT_PER_IP_DAY=
RATE_LIMIT_ACCOUNT_PER_USER=

# --- Generated NEW on the server (never reuse the development ones) ----
# MySQL root password. The MySQL volume keeps the FIRST one it was created with.
#   openssl rand -hex 24
DB_PASSWORD=<GENERATE hex 24>
# Passwords of bongalink_app and bongalink_ml: put the same two in create_app_users.sql (section 5).
#   openssl rand -hex 24      (once for each, two different values)
API_DB_PASSWORD=<GENERATE hex 24>
ML_DB_PASSWORD=<GENERATE hex 24>
# Signs login tokens (a new one logs everyone out once, which is fine at go-live).
#   openssl rand -base64 48
JWT_SECRET=<GENERATE base64 48>
# Hashes the emailed 6-digit codes.
#   openssl rand -hex 32
VERIFICATION_SECRET=<GENERATE hex 32>

# --- Copied from your local Backend/.env -------------------------------
# Encryption of personal information: MUST be the keys bongalink_real was encrypted with.
DATA_ENCRYPTION_KEY=<COPY>
DATA_INDEX_KEY=<COPY>
DATA_ENCRYPTION_KEY_VERSION=<COPY>
DATA_ENCRYPTION_KEY_V1=<COPY>
JWT_EXPIRES_IN=<COPY>

# PayMongo, LIVE mode: the sk_live_ key.
PAYMONGO_SECRET_KEY=<COPY>
# The webhook secret belongs to ONE webhook URL: a new URL means a new webhook with a new whsk_.
# After the domain is live: PayMongo Dashboard (Live mode) > Developers > Webhooks > create
#   URL    https://<DOMAIN>/api/v1/webhooks/paymongo
#   event  checkout_session.payment.paid
# then paste its whsk_ here, restart the API (docker compose up -d api), and disable the old
# development webhook. Until then, paid orders are NOT marked paid.
PAYMONGO_WEBHOOK_SECRET=<NEW_WEBHOOK>
PAYMONGO_METHODS=<COPY>
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=<COPY>

# Lalamove, production keys. Also change the webhook in the Lalamove Partner Portal > Developers to
#   https://<DOMAIN>/api/v1/webhooks/lalamove
LALAMOVE_ENV=<COPY>
LALAMOVE_API_KEY=<COPY>
LALAMOVE_API_SECRET=<COPY>
LALAMOVE_SERVICE_TYPE=<COPY>
LALAMOVE_SERVICE_AREAS=<COPY>

# Email (Gmail App Password): verification codes, password resets, order alerts.
SMTP_HOST=<COPY>
SMTP_PORT=<COPY>
SMTP_USER=<COPY>
SMTP_PASS=<COPY>
MAIL_FROM=<COPY>
ADMIN_ALERT_EMAIL=<COPY>

# AI chat support (Google Gemini).
GEMINI_API_KEY=<COPY>
GEMINI_MODEL=<COPY>
GEMINI_FALLBACK_MODEL=<COPY>

# Map pins (OpenStreetMap Nominatim).
GEOCODER_CONTACT=<COPY>
NOMINATIM_URL=<COPY>

# The shop: Lalamove pickup point and the chat's contact details.
STORE_LAT=<COPY>
STORE_LNG=<COPY>
STORE_ADDRESS=<COPY>
STORE_CONTACT_NAME=<COPY>
STORE_PHONE=<COPY>
STORE_EMAIL=<COPY>

# Courier tracking pages ({tn} = tracking number).
TRACKING_URL_JNT=<COPY>
TRACKING_URL_LBC=<COPY>

# --- ML worker tuning: blank = the worker's defaults -------------------
ML_TRAINER=
ML_POLL_SECONDS=
ML_QUIET_SECONDS=
ML_MAX_WAIT_SECONDS=
ML_FULL_REFRESH_MINUTES=
ML_RETRY_SECONDS=
ML_COLD_START_DAYS=
ML_TREND_MIN_SALE_DAYS=
ML_RETRAIN_HOUR=
ML_RETRAIN_NEW_ORDERS=
ML_RETRAIN_STOCK_CHANGES=
ML_LOG_LEVEL=
