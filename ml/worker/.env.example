# Copy to ml/worker/.env. Database names match Backend/.env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bongalink

# Debounce: process a batch once edits stop for ML_QUIET_SECONDS,
# or once the oldest pending change is ML_MAX_WAIT_SECONDS old.
ML_POLL_SECONDS=5
ML_QUIET_SECONDS=10
ML_MAX_WAIT_SECONDS=60
ML_FULL_REFRESH_MINUTES=60

# Cold start: products listed fewer days ago than this (or never sold) show
# their category's average forecast, labelled "insufficient data".
ML_COLD_START_DAYS=28

# Trend labels need sales on at least this many distinct days in the 84-day window;
# otherwise the trend shows "insufficient data".
ML_TREND_MIN_SALE_DAYS=8

# Automatic retraining (REQ028). Any of these can be turned off with "off".
# Nightly: the first poll at or after this local hour (0-23).
ML_RETRAIN_HOUR=2
# Or as soon as this many new paid orders, or this many stock changes, have
# arrived since the last training. Admins can also retrain any time from the
# Forecasts page ("Update forecasts & trends").
ML_RETRAIN_NEW_ORDERS=50
ML_RETRAIN_STOCK_CHANGES=100

# tensorflow = always train with TensorFlow (training fails if it is missing).
# auto       = fall back to closed-form least squares, recorded in trained_with.
ML_TRAINER=tensorflow

ML_MODELS_DIR=models
ML_BOOTSTRAP_DIR=../backend/models
ML_LOG_LEVEL=INFO
